FROM golang:1.27-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends bpftool clang llvm libbpf-dev ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY agent ./agent
COPY scripts ./scripts
COPY internal ./internal
COPY cmd/contextslo-sensor ./cmd/contextslo-sensor
RUN sh scripts/generate-ebpf.sh
RUN CGO_ENABLED=0 go build -tags ebpf -trimpath -ldflags="-s -w" -o /contextslo-sensor ./cmd/contextslo-sensor

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /contextslo-sensor /contextslo-sensor
USER 65532:65532
ENTRYPOINT ["/contextslo-sensor"]
